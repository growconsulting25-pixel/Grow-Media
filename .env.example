# Public site URL used for canonical URLs, hreflang and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://example.com
# Set to "true" to render clearly-labelled demo testimonials (development only).
NEXT_PUBLIC_SHOW_DEMO_SOCIAL_PROOF=false

# Supabase (Project Settings → API). Without these the site runs, and the
# client area shows an "accounts opening soon" screen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable once Google is configured in Supabase → Authentication → Providers.
NEXT_PUBLIC_AUTH_GOOGLE=false

# --- Server-only secrets (set in Netlify → Environment variables, never in code) ---
# Supabase → Project Settings → API Keys → secret / service_role key
SUPABASE_SERVICE_ROLE_KEY=
# Resend → API Keys
RESEND_API_KEY=
EMAIL_FROM="Grow Media <media@growconsulting.ca>"
# Receives "new project" alerts for the production team
ADMIN_NOTIFY_EMAIL=media@growconsulting.ca
# Random string protecting /api/email/dispatch (called by the scheduled function)
CRON_SECRET=

# --- Stripe (Netlify → Environment variables, secret) ---
STRIPE_SECRET_KEY=
# From the webhook endpoint https://<site>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Optional: fixed Stripe Price IDs (otherwise prices come from src/config/pricing.ts)
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_AGENT=
STRIPE_PRICE_PRO=
# "true" once Stripe Tax is set up (GST/QST)
STRIPE_AUTOMATIC_TAX=false
